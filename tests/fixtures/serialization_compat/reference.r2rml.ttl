# R2RML mapping generated by r2g (source: relational).
# Relational -> RDF for SPARQL->SQL pushdown (e.g. Ontop). No data movement.
# Concept IRIs: <urn:arango-sparql:concept#...>   Resource IRIs: <http://r2g.example/resource/...>

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#User>
    a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "users" ] ;
    rr:subjectMap [
        rr:template "http://r2g.example/resource/User/{id}" ;
        rr:class <urn:arango-sparql:concept#User> ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#userId> ;
        rr:objectMap [ rr:column "id" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#emailAddress> ;
        rr:objectMap [ rr:column "email" ; rr:datatype xsd:string ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#createdAt> ;
        rr:objectMap [ rr:column "created_at" ; rr:datatype xsd:dateTime ] ;
    ] .
# NOTE: computed properties omitted (need SQL): fullName

<#Order>
    a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "orders" ] ;
    rr:subjectMap [
        rr:template "http://r2g.example/resource/Order/{id}" ;
        rr:class <urn:arango-sparql:concept#Order> ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#id> ;
        rr:objectMap [ rr:column "id" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#userId> ;
        rr:objectMap [ rr:column "user_id" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#total> ;
        rr:objectMap [ rr:column "total" ; rr:datatype xsd:decimal ] ;
    ] .

# Skipped edges (endpoint not a mapped document entity — e.g. join-table M2M):
#   placed (User->Order)
#   shipped_item (Shipment->OrderItem)

